{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\OIG-Monitor\\segment-hub\\logs\\hub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "ConnectionStrings": {
    "SapCompany": "Server=SERVER2025;Database=SAP_OIG;Integrated Security=SSPI;TrustServerCertificate=True;ApplicationIntent=ReadOnly"
  },

  "Alerting": {
    "TeamsWebhookUrl": ""
  },

  "Hub": {
    "ShadowMode": true,

    "ServiceLayer": {
      "BaseUrl": "https://localhost:50000/b1s/v1",
      "CompanyDb": "__SET_COMPANY_DB__",
      "UserName": "__SET_SL_USERNAME__",
      "TimeoutSeconds": 30,
      "SslRejectUnauthorized": false
    },

    "Queue": {
      "RootPath": "C:\\ES_SAP\\ES_SegmentFile\\ESG_SegmentFiles_API\\Documents",
      "MaxBatch": 50
    },

    "DefaultFatherCard": "2005000",
    "FatherCardByBranch": {
      "__comment": "branch code (Entry col 2) -> Electra father card. Fill from @ESG_CONF on 220.",
      "999": "2004999"
    },

    "Interfaces": {
      "SupplyApprovals": {
        "Enabled": true,
        "ShadowMode": true,
        "Encoding": "utf-8",
        "PollSeconds": 60,
        "InboundFolder": "SupplyApprovals"
      },
      "Orders": {
        "Enabled": true,
        "ShadowMode": true,
        "Encoding": "windows-1255",
        "PollSeconds": 30,
        "InboundFolder": "Orders"
      },
      "DeliveryNotes": {
        "Enabled": true,
        "ShadowMode": true,
        "Encoding": "utf-8",
        "PollSeconds": 60,
        "InboundFolder": "DeliveryNotes"
      },
      "HundredFile": {
        "Enabled": true,
        "ShadowMode": true,
        "OutboundRunHour": 16
      }
    }
  }
}
