{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft": "Warning", "System.Net.Http": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\OIG-Monitor\\segment-hub\\logs\\hub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },

  "ConnectionStrings": {
    "SapCompany": "Server=SERVER2025;Database=SAP_OIG;Integrated Security=SSPI;TrustServerCertificate=True;ApplicationIntent=ReadOnly"
  },

  "Alerting": {
    "TeamsWebhookUrl": ""
  },

  "Hub": {
    "ShadowMode": true,

    "ServiceLayer": {
      "BaseUrl": "https://localhost:50000/b1s/v1",
      "CompanyDb": "__SET_COMPANY_DB__",
      "UserName": "__SET_SL_USERNAME__",
      "TimeoutSeconds": 30,
      "SslRejectUnauthorized": false
    },

    "Queue": {
      "RootPath": "C:\\ES_SAP\\ES_SegmentFile\\ESG_SegmentFiles_API\\Documents",
      "MaxBatch": 50,
      "ShadowOutputPath": "C:\\OIG-Monitor\\segment-hub\\shadow-out"
    },

    "DefaultFatherCard": "2005000",
    "FatherCardByBranch": {
      "__comment": "branch code (Entry col 2) -> Electra father card. Fill from @ESG_CONF on 220.",
      "999": "2004999"
    },

    "Interfaces": {
      "SupplyApprovals": {
        "Enabled": true,
        "ShadowMode": true,
        "Encoding": "windows-1255",
        "PollSeconds": 60,
        "InboundFolder": "SupplyApprovals"
      },
      "Orders": {
        "Enabled": true,
        "ShadowMode": true,
        "Encoding": "windows-1255",
        "PollSeconds": 30,
        "InboundFolder": "Orders"
      },
      "DeliveryNotes": {
        "__note": "DISABLED: EasySale EXPORTS delivery notes (SAP->file), it does not import a status file. The inbound module is wrong-direction and stays off until the real ממשק 9 requirement is confirmed.",
        "Enabled": false,
        "ShadowMode": true,
        "Encoding": "utf-8",
        "PollSeconds": 60,
        "InboundFolder": "DeliveryNotes"
      },
      "HundredFile": {
        "Enabled": true,
        "ShadowMode": true,
        "OutboundRunHour": 16
      },
      "HomeDeliveryInvoicing": {
        "__note": "Off until the hub runs where electra-worker's prod-status.json is readable (VM) and Hub__HomeDelivery__StatusFilePath is set. Then enable in shadow and compare with the manual invoices.",
        "Enabled": false,
        "ShadowMode": true,
        "OutboundRunHour": 19
      }
    },

    "HomeDelivery": {
      "FatherCards": [ "2005000", "2004999", "2005207" ],
      "StatusFilePath": "__SET_STATUS_FILE_PATH__",
      "DeliveredStatus": "Delivered",
      "RefusedStatuses": [ "Refuse" ],
      "LookbackDays": 60,
      "StaleStatusHours": 24,
      "InTransitAlertDays": 7
    }
  }
}
