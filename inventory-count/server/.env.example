# --- Server ---
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/inventory.db
# true when served over HTTPS (recommended in production)
COOKIE_SECURE=false

# First manager account, created only if no users exist
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PIN=change-me-1234

# Warehouses handled by the system: code:name, comma separated
WAREHOUSES=15:מחסן מעבדה,151:מחסן צבר

# --- SAP ---
# mock = demo data, no SAP connection. live = real SAP B1
SAP_MODE=mock

# Read-only SQL access to the company DB (snapshot + freeze check)
SAP_SQL_SERVER=
SAP_SQL_DATABASE=
SAP_SQL_USER=
SAP_SQL_PASSWORD=
SAP_SQL_ENCRYPT=false

# Service Layer (creating the Inventory Counting document)
SL_URL=https://sap-server:50000/b1s/v1
SL_COMPANY_DB=
SL_USER=
SL_PASSWORD=
# false only if Service Layer uses a self-signed certificate
SL_TLS_VERIFY=true
